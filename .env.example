# WARDEN Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (Leave as sqlite for quick demo, or use postgres)
DATABASE_URL=sqlite:///./warden.db
# DATABASE_URL=postgresql://warden:warden@localhost:5432/warden

# JWT Secrets
JWT_SECRET=warden_super_secret_demo_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OPA Configuration
OPA_URL=http://localhost:8181/v1/data/warden
OPA_FALLBACK_ENABLED=true

# Layer 0 Content Guard (Qwen3Guard-Gen-0.6B via llama.cpp OpenAI-compatible API)
# Start the model server with docker compose up guard, or run llama-server manually.
# Set QWEN_GUARD_ENABLED=false to skip L0 (L1-L4 remain active).
QWEN_GUARD_URL=http://localhost:8322
QWEN_GUARD_ENABLED=true
QWEN_GUARD_FAIL_CLOSED=true
QWEN_GUARD_MODEL=guard
QWEN_GUARD_TIMEOUT_SECONDS=10
QWEN_GUARD_MAX_TOKENS=64
QWEN_GUARD_BREAKER_THRESHOLD=3
QWEN_GUARD_BREAKER_COOLDOWN_S=30
# Instruction-override strike escalation (kill switch after N strikes)
WARDEN_GUARD_STRIKES_THRESHOLD=2
WARDEN_GUARD_STRIKES_WINDOW_S=300

# Approvals & Escalation SLA (in seconds, default 120s for demo)
DEFAULT_APPROVAL_SLA_SECONDS=120
ESCALATION_CHECK_INTERVAL_SECONDS=5

# Optional LLM API Keys (for demo agent in natural language mode)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Connected AI Agents Key Encryption & Security
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=
ALLOW_LOCAL_UPSTREAMS=false
